            <span className="px-3 py-1 bg-indigo-500/10 text-indigo-400 text-xs font-semibold rounded-full border border-indigo-500/20">
              {current.topic}
            </span>
            <span className="text-xs text-slate-400 font-medium">
              Vježba {index + 1} od {exercises.length}
            </span>
          </div>

          <button
            onClick={() => speak(current.prompt)}
            className="text-slate-400 hover:text-white text-xs font-medium flex items-center gap-1.5 bg-slate-950 px-3 py-1.5 rounded-lg border border-slate-800 transition"
          >
            <Volume2 className="w-3.5 h-3.5 text-indigo-400" /> Poslušaj zadatak
          </button>
        </div>

        <div>
          <h3 className="text-slate-100 font-bold text-base sm:text-lg mb-2">{current.scenario}</h3>
          <p className="text-slate-300 text-sm leading-relaxed bg-slate-950/60 p-4 rounded-xl border border-slate-800/80">
            {current.prompt}
