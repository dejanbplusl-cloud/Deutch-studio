// MODULE 1: WRITING & STYLE
// ==========================================
function WritingModule({ exercises, onComplete, speak, selectedTopic, setSelectedTopic }) {
  const [index, setIndex] = useState(0);
  const [userInput, setUserInput] = useState('');
  const [showResult, setShowResult] = useState(false);

  const current = exercises[index] || exercises[0];

  useEffect(() => {
    setUserInput('');
    setShowResult(false);
  }, [index, selectedTopic]);

  if (!current) {
    return (
      <div className="bg-slate-900/80 border border-slate-800 rounded-2xl p-8 text-center text-slate-400">
        Nema vježbi za izabranu kategoriju. Izaberi drugu kategoriju sa trake iznad.
