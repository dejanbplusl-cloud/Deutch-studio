// MODULE 3: VOCABULARY B1 -> B2
// ==========================================
function VocabularyModule({ items, onComplete, speak }) {
  const [index, setIndex] = useState(0);
  const [selectedOption, setSelectedOption] = useState(null);
  const [submitted, setSubmitted] = useState(false);

  const current = items[index] || items[0];

  useEffect(() => {
    setSelectedOption(null);
    setSubmitted(false);
  }, [index]);

  if (!current) {
    return (
      <div className="bg-slate-900/80 border border-slate-800 rounded-2xl p-8 text-center text-slate-400">
        Nema vokabulara u ovoj kategoriji.
      </div>
    );
  }

  const handleSelect = (option) => {
    if (submitted) return;
    setSelectedOption(option);
    setSubmitted(true);
    if (onComplete) onComplete(option === current.correctOption);
  };

  const handleNext = () => {
    setSelectedOption(null);
    setSubmitted(false);
    setIndex((prev) => (prev + 1) % items.length);
  };

  return (
    <div className="max-w-4xl mx-auto flex flex-col gap-6">
      <div className="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-6">
        <div className="bg-slate-950 p-5 rounded-2xl border border-slate-800 space-y-2">
          <span className="text-[10px] font-bold text-amber-400 uppercase tracking-wider block">B1 Osnovni Izraz:</span>
          <span className="text-xl font-bold text-white block">{current.basic}</span>
          <p className="text-xs text-slate-400 italic">Kontekst: "{current.context}"</p>
        </div>

        <p className="text-xs font-bold text-slate-300 uppercase tracking-wider">
          Izaberi naprednu B2/C1 zamjenu za ovaj izraz:
        </p>

        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {current.options.map((option, i) => {
            const isCorrect = option === current.correctOption;
            const isSelected = selectedOption === option;

            let btnStyle = 'bg-slate-950 border-slate-800 text-slate-200 hover:border-slate-700';
            if (submitted) {
              if (isCorrect) btnStyle = 'bg-emerald-950/40 border-emerald-500 text-emerald-300';
              else if (isSelected) btnStyle = 'bg-rose-950/40 border-rose-500 text-rose-300';
            }

            return (
              <button
                key={i}
                onClick={() => handleSelect(option)}
                disabled={submitted}
                className={`p-4 rounded-xl border font-semibold text-sm transition text-left flex items-center justify-between ${btnStyle}`}
              >
                <span>{option}</span>
                {submitted && isCorrect && <Check className="w-4 h-4 text-emerald-400 shrink-0" />}
              </button>
            );
          })}
        </div>

        {submitted && (
          <div className="space-y-4 pt-4 border-t border-slate-800 animate-fadeIn">
            <div className="bg-indigo-950/20 border border-indigo-500/30 p-4 rounded-xl space-y-2 text-xs">
              <span className="font-bold text-indigo-400 block uppercase">Fiksna B2 Fraza (Redemittel):</span>
              <p className="text-slate-200 font-mono">{current.redemittel}</p>
              <p className="text-slate-400 italic">Primer: "{current.example}"</p>
            </div>

            <button
              onClick={handleNext}
              className="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl font-bold text-sm transition flex items-center justify-center gap-2"
            >
              <RotateCcw className="w-4 h-4" /> Sljedeći Izraz
            </button>
          </div>
        )}
      </div>
    </div>
  );
}

