                <button onClick={() => speak(current.answerB2)} className="text-slate-400 hover:text-white p-1">
                  <Volume2 className="w-3.5 h-3.5 text-emerald-400" />
                </button>
              </div>
              <p className="text-slate-100 text-sm font-medium italic mb-3">"{current.answerB2}"</p>
              
              {current.tips && current.tips.length > 0 && (
                <div className="mt-3 pt-3 border-t border-emerald-500/20 space-y-1">
                  <span className="text-[10px] font-bold text-emerald-400 uppercase block mb-1">Savjeti za B2 stil:</span>
                  {current.tips.map((tip, i) => (
                    <p key={i} className="text-xs text-slate-300 flex items-start gap-1.5">
