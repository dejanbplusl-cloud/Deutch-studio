              <div className="flex items-center justify-between gap-2 mb-2">
                <span className="text-xs font-bold text-amber-400 uppercase tracking-wider">Standardni B1 Odgovor:</span>
                <button onClick={() => speak(current.answerB1)} className="text-slate-400 hover:text-white p-1">
                  <Volume2 className="w-3.5 h-3.5" />
                </button>
              </div>
              <p className="text-slate-300 text-sm italic">"{current.answerB1}"</p>
