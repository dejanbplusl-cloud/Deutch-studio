// MODULE 4: GRAMMAR DRILL
// ==========================================
function GrammarDrillModule({ drills, onComplete }) {
  const [index, setIndex] = useState(0);
  const [selectedOpt, setSelectedOpt] = useState(null);

  const current = drills[index] || drills[0];

  if (!current) {
    return (
      <div className="bg-slate-900/80 border border-slate-800 rounded-2xl p-8 text-center text-slate-400">
        Nema gramatičkih vježbi za izabranu temu.
      </div>
    );
  }

  const handleChoose = (opt) => {
    setSelectedOpt(opt);
    if (onComplete) onComplete(opt === current.correct);
  };

  const handleNext = () => {
    setSelectedOpt(null);
    setIndex((prev) => (prev + 1) % drills.length);
  };

  return (
    <div className="max-w-4xl mx-auto flex flex-col gap-6">
      <div className="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-6">
        <div className="bg-slate-950 p-6 rounded-2xl border border-slate-800 text-center text-base font-semibold text-slate-100">
          {current.question}
        </div>

        <div className="grid grid-cols-2 gap-3">
          {current.options.map((opt, i) => {
            const isCorrect = opt === current.correct;
            const isSelected = selectedOpt === opt;

            let style = 'bg-slate-950 border-slate-800 text-slate-200 hover:border-slate-700';
            if (selectedOpt !== null) {
              if (isCorrect) style = 'bg-emerald-950/40 border-emerald-500 text-emerald-300 font-bold';
              else if (isSelected) style = 'bg-rose-950/40 border-rose-500 text-rose-300 font-bold';
            }

            return (
              <button
                key={i}
                onClick={() => handleChoose(opt)}
                disabled={selectedOpt !== null}
                className={`p-4 rounded-xl border text-sm transition text-center ${style}`}
              >
                {opt}
              </button>
            );
          })}
        </div>

        {selectedOpt !== null && (
          <div className="space-y-4 pt-4 border-t border-slate-800 animate-fadeIn">
            <div className="bg-slate-950 p-4 rounded-xl border border-slate-800 text-xs text-slate-300">
              <span className="font-bold text-indigo-400 block mb-1">Objašnjenje pravila:</span>
              {current.explanation}
            </div>

            <button
              onClick={handleNext}
              className="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl font-bold text-sm transition flex items-center justify-center gap-2"
            >
              <RotateCcw className="w-4 h-4" /> Sljedeće Pitanje
            </button>
          </div>
        )}
      </div>
    </div>
  );
}

// ==========================================
// MODULE 5: PERSONAL LAB & LESSON MANAGER
// ==========================================
function PersonalLabModule({ mistakes, customLab, onAddCustom, onRemoveMistake, onRemoveCustom, speak }) {
  const [activeSubTab, setActiveSubTab] = useState('mistakes');
  const [germanText, setGermanText] = useState('');
  const [translationText, setTranslationText] = useState('');
  const [noteText, setNoteText] = useState('');

  // Import / Export state
  const [jsonInput, setJsonInput] = useState('');
  const [importStatus, setImportStatus] = useState(null);

  const handleAdd = (e) => {
    e.preventDefault();
    if (!germanText.trim()) return;

    onAddCustom({
      id: 'custom_' + Date.now(),
      german: germanText,
      translation: translationText,
      note: noteText,
      date: new Date().toLocaleDateString()
    });

    setGermanText('');
    setTranslationText('');
    setNoteText('');
  };

  // Export custom data to JSON
  const handleExportJSON = () => {
    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(customLab, null, 2));
    const downloadAnchor = document.createElement('a');
    downloadAnchor.setAttribute("href", dataStr);
    downloadAnchor.setAttribute("download", `deutsch_lessons_backup_${Date.now()}.json`);
    document.body.appendChild(downloadAnchor);
    downloadAnchor.click();
    downloadAnchor.remove();
  };

  // Import JSON file or raw string
  const handleImportJSON = () => {
    try {
      const parsed = JSON.parse(jsonInput);
      if (Array.isArray(parsed)) {
        parsed.forEach(item => {
          if (item.german) {
            onAddCustom({
              id: item.id || 'custom_' + Date.now() + Math.random(),
              german: item.german,
              translation: item.translation || '',
              note: item.note || '',
              date: item.date || new Date().toLocaleDateString()
            });
          }
        });
        setImportStatus('✅ Lekcije uspješno uvezene!');
        setJsonInput('');
      } else {
        setImportStatus('❌ Greška: JSON mora biti lista (Array) objekata.');
      }
    } catch (err) {
      setImportStatus('❌ Neispravan JSON format!');
    }
  };

  return (
    <div className="max-w-4xl mx-auto flex flex-col gap-6">
      {/* Sub tabs */}
      <div className="flex items-center gap-3 border-b border-slate-800 pb-3 overflow-x-auto scrollbar-none">
        <button
          onClick={() => setActiveSubTab('mistakes')}
          className={`text-xs sm:text-sm font-bold px-4 py-2 rounded-xl transition shrink-0 ${
            activeSubTab === 'mistakes'
              ? 'bg-indigo-600 text-white'
              : 'text-slate-400 hover:text-white bg-slate-900/60'
          }`}
        >
          Sačuvane Greške ({mistakes.length})
        </button>

        <button
          onClick={() => setActiveSubTab('custom')}
          className={`text-xs sm:text-sm font-bold px-4 py-2 rounded-xl transition shrink-0 ${
            activeSubTab === 'custom'
              ? 'bg-indigo-600 text-white'
              : 'text-slate-400 hover:text-white bg-slate-900/60'
          }`}
        >
          Moje Lične Rečenice & Fraze ({customLab.length})
        </button>

        <button
          onClick={() => setActiveSubTab('manager')}
          className={`text-xs sm:text-sm font-bold px-4 py-2 rounded-xl transition shrink-0 flex items-center gap-1.5 ${
            activeSubTab === 'manager'
              ? 'bg-gradient-to-r from-violet-600 to-indigo-600 text-white'
              : 'text-indigo-400 hover:text-indigo-300 bg-indigo-950/40 border border-indigo-800/40'
          }`}
        >
          <Sparkles className="w-3.5 h-3.5" /> Uvoz / Izvoz Lekcija (JSON)
        </button>
      </div>

      {activeSubTab === 'mistakes' && (
        <div className="space-y-4">
          {mistakes.length === 0 ? (
            <div className="bg-slate-900/60 border border-slate-800 rounded-2xl p-8 text-center text-slate-400 text-sm">
              Nemaš sačuvanih grešaka! Kad god pogriješiš u Detektoru Grešaka, stavka će automatski stići ovdje.
            </div>
          ) : (
            mistakes.map((item) => (
              <div key={item.id} className="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 relative">
                <div className="flex items-center justify-between gap-2 mb-2">
                  <span className="text-[10px] font-bold text-rose-400 uppercase tracking-wider bg-rose-500/10 px-2 py-0.5 rounded border border-rose-500/20">
                    {item.category}
                  </span>
                  <button
                    onClick={() => onRemoveMistake(item.id)}
                    className="p-1.5 text-slate-500 hover:text-rose-400 rounded-lg hover:bg-slate-800 transition"
                    title="Ukloni"
                  >
                    <Trash2 className="w-4 h-4" />
                  </button>
                </div>

                <p className="text-slate-400 text-xs line-through mb-1">"{item.sentence}"</p>
                <p className="text-emerald-300 text-sm font-semibold mb-2">"{item.correctSentence}"</p>
                <p className="text-slate-300 text-xs leading-relaxed bg-slate-950/60 p-3 rounded-xl border border-slate-800/60">
                  {item.explanation}
                </p>
              </div>
            ))
          )}
        </div>
      )}

      {activeSubTab === 'custom' && (
        <div className="space-y-6">
          {/* Add custom form */}
          <form onSubmit={handleAdd} className="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
            <h4 className="font-bold text-sm text-white flex items-center gap-2">
              <Plus className="w-4 h-4 text-indigo-400" />
              Dodaj Novu Riječ ili Rečenicu sa Posla / iz Svakodnevice
            </h4>

            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label className="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">
                  Njemački tekst (izraz / rečenica):
                </label>
                <input
                  type="text"
                  value={germanText}
                  onChange={(e) => setGermanText(e.target.value)}
                  placeholder="npr. Ich möchte mich bezüglich der Stelle erkundigen."
                  className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-sm text-slate-100 focus:outline-none focus:border-indigo-500"
                />
              </div>

              <div>
                <label className="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">
                  Prevod / Značenje:
                </label>
                <input
                  type="text"
                  value={translationText}
                  onChange={(e) => setTranslationText(e.target.value)}
                  placeholder="npr. Želim se raspitati u vezi posla."
                  className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-sm text-slate-100 focus:outline-none focus:border-indigo-500"
                />
              </div>
            </div>

            <div>
              <label className="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">
                Napomena / Gramatika (opciono):
              </label>
              <input
                type="text"
                value={noteText}
                onChange={(e) => setNoteText(e.target.value)}
                placeholder="npr. erkundigen nach + Dativ / bezüglich + Genitiv"
                className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-sm text-slate-100 focus:outline-none focus:border-indigo-500"
              />
            </div>

            <button
              type="submit"
              disabled={!germanText.trim()}
              className="w-full py-3 bg-indigo-600 hover:bg-indigo-500 disabled:opacity-40 text-white rounded-xl font-bold text-xs sm:text-sm transition shadow-md flex items-center justify-center gap-2"
            >
              <Plus className="w-4 h-4" /> Sačuvaj u Bazu
            </button>
          </form>

          {/* List custom items */}
          <div className="space-y-3">
            {customLab.length === 0 ? (
              <div className="bg-slate-900/60 border border-slate-800 rounded-2xl p-8 text-center text-slate-400 text-sm">
                Tvoja lična baza je prazna. Dodaj gore fraze ili izraze koje čuješ na poslu ili u opštini!
              </div>
            ) : (
              customLab.map((item) => (
                <div key={item.id} className="bg-slate-900/80 border border-slate-800 rounded-2xl p-4 flex items-center justify-between gap-4">
                  <div className="flex-1">
                    <div className="flex items-center gap-2 mb-1">
                      <span className="font-bold text-sm text-slate-100">{item.german}</span>
                      <button 
                        onClick={() => speak(item.german)}
                        className="text-slate-400 hover:text-white p-1 rounded"
                      >
                        <Volume2 className="w-3.5 h-3.5" />
                      </button>
                    </div>
                    {item.translation && (
                      <p className="text-xs text-slate-400">{item.translation}</p>
                    )}
                    {item.note && (
                      <span className="inline-block mt-1 text-[10px] bg-slate-950 px-2 py-0.5 rounded text-indigo-400 border border-slate-800">
                        {item.note}
                      </span>
                    )}
                  </div>

                  <button
                    onClick={() => onRemoveCustom(item.id)}
                    className="p-2 text-slate-500 hover:text-rose-400 rounded-lg hover:bg-slate-800 transition shrink-0"
                    title="Ukloni"
                  >
                    <Trash2 className="w-4 h-4" />
                  </button>
                </div>
              ))
            )}
          </div>
        </div>
      )}

      {/* JSON MANAGER TAB */}
      {activeSubTab === 'manager' && (
        <div className="space-y-6">
          <div className="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
            <h4 className="font-bold text-base text-white flex items-center gap-2">
              <BookOpen className="w-5 h-5 text-indigo-400" />
              Uvoz i Izvoz Kompletnih Lekcija u JSON Formatu
            </h4>
            <p className="text-xs text-slate-400 leading-relaxed">
              Ovdje možeš uvesti pakete novih rečenica i vokabulara ili izvoziti sve rečenice koje si sam unio kako bi napravio sigurnosnu kopiju (backup).
            </p>

            <div className="flex gap-3 pt-2">
              <button
                onClick={handleExportJSON}
                disabled={customLab.length === 0}
                className="px-4 py-2.5 bg-slate-800 hover:bg-slate-700 disabled:opacity-40 text-slate-200 rounded-xl font-bold text-xs transition border border-slate-700 flex items-center gap-2"
              >
                <Bookmark className="w-4 h-4 text-amber-400" /> Izvezi Moje Lekcije (.json)
              </button>
            </div>
          </div>

          <div className="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
            <h5 className="font-bold text-sm text-white">Uvezi Nove Lekcije (Nalijepi JSON Kod)</h5>
            
            <textarea
              rows={6}
              value={jsonInput}
              onChange={(e) => setJsonInput(e.target.value)}
              placeholder={`[\n  {\n    "german": "Der Server ist vorübergehend außer Betrieb.",\n    "translation": "Server je privremeno van funkcije.",\n    "note": "IT / Systemadministration"\n  }\n]`}
              className="w-full bg-slate-950 border border-slate-800 rounded-xl p-4 text-slate-100 text-xs font-mono focus:outline-none focus:border-indigo-500 resize-none"
            />

            {importStatus && (
              <p className="text-xs font-bold text-indigo-300">{importStatus}</p>
            )}

            <button
              onClick={handleImportJSON}
              disabled={!jsonInput.trim()}
              className="w-full py-3 bg-indigo-600 hover:bg-indigo-500 disabled:opacity-40 text-white rounded-xl font-bold text-xs sm:text-sm transition"
            >
              Uvezi Lekcije u Bazu
            </button>
          </div>
        </div>
      )}
    </div>
  );
}

// ==========================================
// MAIN APP COMPONENT
// ==========================================
export default function App() {
  const [activeTab, setActiveTab] = useState('writing');
  const [selectedTopic, setSelectedTopic] = useState('All');
  
  // Stats
  const [stats, setStats] = useState(() => {
    const saved = localStorage.getItem('de_meister_stats');
    return saved ? JSON.parse(saved) : { xp: 120, streak: 3, completed: 14 };
  });

  // Saved Errors
  const [mistakes, setMistakes] = useState(() => {
    const saved = localStorage.getItem('de_meister_mistakes');
    return saved ? JSON.parse(saved) : [];
  });

  // Custom Phrases
  const [customLab, setCustomLab] = useState(() => {
    const saved = localStorage.getItem('de_meister_custom');
    return saved ? JSON.parse(saved) : [];
  });

  useEffect(() => {
    localStorage.setItem('de_meister_stats', JSON.stringify(stats));
  }, [stats]);

  useEffect(() => {
    localStorage.setItem('de_meister_mistakes', JSON.stringify(mistakes));
  }, [mistakes]);

  useEffect(() => {
    localStorage.setItem('de_meister_custom', JSON.stringify(customLab));
  }, [customLab]);

  // Audio Speech synthesis
  const speak = (text) => {
    if (!('speechSynthesis' in window)) return;
    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = 'de-DE';
    utterance.rate = 0.9;
    window.speechSynthesis.speak(utterance);
  };

  const handleExerciseComplete = (isCorrect) => {
    setStats(prev => ({
      ...prev,
      xp: prev.xp + (isCorrect ? 15 : 5),
      completed: prev.completed + 1
    }));
  };

  const handleAddMistake = (item) => {
    setMistakes(prev => {
      if (prev.some(m => m.id === item.id)) return prev;
      return [item, ...prev];
    });
  };

  const handleRemoveMistake = (id) => {
    setMistakes(prev => prev.filter(m => m.id !== id));
  };

  const handleAddCustom = (newItem) => {
    setCustomLab(prev => [newItem, ...prev]);
  };

  const handleRemoveCustom = (id) => {
    setCustomLab(prev => prev.filter(c => c.id !== id));
  };

  // Filter dataset based on selected topic
  const filterByTopic = (list) => {
    if (selectedTopic === 'All') return list;
    return list.filter(item => item.topic === selectedTopic);
  };

  const filteredWriting = filterByTopic(INITIAL_DATASET.writing);
  const filteredErrors = filterByTopic(INITIAL_DATASET.errors);
  const filteredVocabulary = filterByTopic(INITIAL_DATASET.vocabulary);
  const filteredGrammar = filterByTopic(INITIAL_DATASET.grammarDrill);

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 font-sans antialiased pb-12">
      {/* TOP HEADER / NAVBAR */}
      <header className="border-b border-slate-800 bg-slate-900/60 sticky top-0 z-50 backdrop-blur-md">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 py-3.5 flex items-center justify-between gap-4">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center shadow-lg shadow-indigo-500/20">
              <Brain className="w-6 h-6 text-white" />
            </div>
            <div>
              <h1 className="text-base sm:text-lg font-extrabold bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-100 to-slate-400">
                Deutsch Studio B1/B2
              </h1>
              <p className="text-[10px] text-indigo-400 font-semibold tracking-wider uppercase">
                Writing & Vocabulary Mastery • IT & Admin Focus
              </p>
            </div>
          </div>

          {/* Gamification Stats */}
          <div className="flex items-center gap-2 sm:gap-4">
            <div className="flex items-center gap-1.5 px-3 py-1.5 bg-slate-950/80 rounded-xl border border-slate-800 text-xs font-bold text-amber-400">
              <Flame className="w-4 h-4 text-amber-500 fill-amber-500" />
              <span>{stats.streak} Days</span>
            </div>

            <div className="flex items-center gap-1.5 px-3 py-1.5 bg-slate-950/80 rounded-xl border border-slate-800 text-xs font-bold text-indigo-400">
              <Trophy className="w-4 h-4 text-indigo-400" />
              <span>{stats.xp} XP</span>
            </div>
          </div>
        </div>
      </header>

      {/* TOPIC FILTER BAR */}
      <div className="bg-slate-900/40 border-b border-slate-800/60 py-2.5">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 flex items-center gap-2">
          <div className="flex items-center gap-1.5 text-xs font-semibold text-slate-400 uppercase tracking-wider shrink-0 mr-2">
            <Filter className="w-3.5 h-3.5 text-indigo-400" />
            <span>Kategorija:</span>
          </div>

          <div className="flex items-center gap-1.5 overflow-x-auto scrollbar-none py-1">
            {ALL_TOPICS.map(t => {
              const Icon = t.icon;
              const isSelected = selectedTopic === t.id;
              const isIT = t.id.includes('IT');
              return (
                <button
                  key={t.id}
                  onClick={() => setSelectedTopic(t.id)}
                  className={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium shrink-0 transition ${
                    isSelected
                      ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/20'
                      : isIT
                      ? 'bg-slate-900 text-indigo-300 border border-indigo-500/30 hover:bg-slate-800'
                      : 'bg-slate-900 text-slate-400 hover:text-slate-200 hover:bg-slate-800 border border-slate-800'
                  }`}
                >
                  <Icon className={`w-3.5 h-3.5 ${isIT && !isSelected ? 'text-indigo-400' : ''}`} />
                  <span>{t.label}</span>
                </button>
              );
            })}
          </div>
        </div>
      </div>

      {/* MAIN NAVIGATION TABS */}
      <nav className="max-w-7xl mx-auto px-4 sm:px-6 pt-6 pb-4">
        <div className="grid grid-cols-2 sm:grid-cols-5 gap-2 bg-slate-900/80 p-1.5 rounded-2xl border border-slate-800">
          <button
            onClick={() => setActiveTab('writing')}
            className={`flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-bold transition ${
              activeTab === 'writing'
                ? 'bg-gradient-to-r from-indigo-600 to-violet-600 text-white shadow-md'
                : 'text-slate-400 hover:text-white hover:bg-slate-800/50'
            }`}
          >
            <PenTool className="w-4 h-4" /> Pisanje & Style
          </button>

          <button
            onClick={() => setActiveTab('error')}
            className={`flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-bold transition ${
              activeTab === 'error'
                ? 'bg-gradient-to-r from-indigo-600 to-violet-600 text-white shadow-md'
                : 'text-slate-400 hover:text-white hover:bg-slate-800/50'
            }`}
          >
            <AlertTriangle className="w-4 h-4" /> Detektor Grešaka
          </button>

          <button
            onClick={() => setActiveTab('vocab')}
            className={`flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-bold transition ${
              activeTab === 'vocab'
                ? 'bg-gradient-to-r from-indigo-600 to-violet-600 text-white shadow-md'
                : 'text-slate-400 hover:text-white hover:bg-slate-800/50'
            }`}
          >
            <BookOpen className="w-4 h-4" /> Vokabular B1 &rarr; B2
          </button>

          <button
            onClick={() => setActiveTab('grammar')}
            className={`flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-bold transition ${
              activeTab === 'grammar'
                ? 'bg-gradient-to-r from-indigo-600 to-violet-600 text-white shadow-md'
                : 'text-slate-400 hover:text-white hover:bg-slate-800/50'
            }`}
          >
            <Sparkles className="w-4 h-4" /> Gramatika Drill
          </button>

          <button
            onClick={() => setActiveTab('lab')}
            className={`col-span-2 sm:col-span-1 flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-bold transition ${
              activeTab === 'lab'
                ? 'bg-gradient-to-r from-indigo-600 to-violet-600 text-white shadow-md'
                : 'text-slate-400 hover:text-white hover:bg-slate-800/50'
            }`}
          >
            <Bookmark className="w-4 h-4" /> Moja Baza ({mistakes.length + customLab.length})
          </button>
        </div>
      </nav>

      {/* MODULE CONTAINER */}
      <main className="max-w-7xl mx-auto px-4 sm:px-6 pt-2">
        {activeTab === 'writing' && (
          <WritingModule 
            exercises={filteredWriting} 
            onComplete={(isCorrect) => handleExerciseComplete(isCorrect)} 
            speak={speak} 
            selectedTopic={selectedTopic}
            setSelectedTopic={setSelectedTopic}
          />
        )}

        {activeTab === 'error' && (
          <ErrorDetectorModule 
            exercises={filteredErrors} 
            onAnswer={(isCorrect, item) => {
              handleExerciseComplete(isCorrect);
              if (!isCorrect && !item.isCorrect) {
                handleAddMistake(item);
              }
            }} 
            speak={speak} 
          />
        )}

        {activeTab === 'vocab' && (
          <VocabularyModule 
            items={filteredVocabulary} 
            onComplete={(isCorrect) => handleExerciseComplete(isCorrect)} 
            speak={speak} 
          />
        )}

        {activeTab === 'grammar' && (
          <GrammarDrillModule 
            drills={filteredGrammar} 
            onComplete={(isCorrect) => handleExerciseComplete(isCorrect)} 
          />
        )}

        {activeTab === 'lab' && (
          <PersonalLabModule 
            mistakes={mistakes} 
            customLab={customLab} 
            onAddCustom={handleAddCustom} 
            onRemoveMistake={handleRemoveMistake} 
            onRemoveCustom={handleRemoveCustom} 
            speak={speak} 
          />
        )}
      </main>
    </div>
  );
}
