    setShowResult(true);
    if (onComplete) onComplete(true);
  };

  return (
    <div className="max-w-4xl mx-auto flex flex-col gap-6">
      <div className="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-6">
        {/* Scenario Header */}
