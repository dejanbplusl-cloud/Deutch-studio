        )}
      </div>
    </div>
  );
}

// ==========================================
// MODULE 2: ERROR DETECTOR
// ==========================================
function ErrorDetectorModule({ exercises, onAnswer, speak }) {
  const [index, setIndex] = useState(0);
  const [selectedChoice, setSelectedChoice] = useState(null);
  const [submitted, setSubmitted] = useState(false);

  const current = exercises[index] || exercises[0];

  useEffect(() => {
    setSelectedChoice(null);
    setSubmitted(false);
  }, [index]);

  if (!current) {
    return (
      <div className="bg-slate-900/80 border border-slate-800 rounded-2xl p-8 text-center text-slate-400">
        Nema vježbi u ovoj kategoriji. Izaberi drugu kategoriju.
      </div>
    );
  }

  const handleSubmit = () => {
    if (selectedChoice === null) return;
    setSubmitted(true);
    const isCorrect = selectedChoice === current.isCorrect;
    if (onAnswer) onAnswer(isCorrect, current);
  };

  const handleNext = () => {
    setSelectedChoice(null);
    setSubmitted(false);
    setIndex((prev) => (prev + 1) % exercises.length);
  };

  return (
    <div className="max-w-4xl mx-auto flex flex-col gap-6">
      <div className="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-6">
        <div className="flex items-center justify-between gap-3 border-b border-slate-800 pb-4">
          <span className="px-3 py-1 bg-violet-500/10 text-violet-400 text-xs font-semibold rounded-full border border-violet-500/20">
            {current.category}
          </span>
          <button onClick={() => speak(current.sentence)} className="text-slate-400 hover:text-white p-1 text-xs flex items-center gap-1">
            <Volume2 className="w-3.5 h-3.5" /> Poslušaj
          </button>
        </div>

        <div className="bg-slate-950 p-6 rounded-2xl border border-slate-800 text-center text-base sm:text-lg font-medium text-slate-100">
          "{current.sentence}"
        </div>

        <div className="grid grid-cols-2 gap-4">
          <button
            onClick={() => !submitted && setSelectedChoice(true)}
            className={`p-4 rounded-xl border font-bold text-sm transition flex flex-col items-center gap-2 ${
              selectedChoice === true
                ? 'bg-emerald-500/20 border-emerald-500 text-emerald-300'
                : 'bg-slate-950 border-slate-800 text-slate-400 hover:border-slate-700'
            }`}
          >
            <CheckCircle2 className="w-6 h-6 text-emerald-400" />
            <span>Tačno (Richtig)</span>
          </button>

          <button
            onClick={() => !submitted && setSelectedChoice(false)}
            className={`p-4 rounded-xl border font-bold text-sm transition flex flex-col items-center gap-2 ${
              selectedChoice === false
                ? 'bg-rose-500/20 border-rose-500 text-rose-300'
                : 'bg-slate-950 border-slate-800 text-slate-400 hover:border-slate-700'
            }`}
          >
            <XCircle className="w-6 h-6 text-rose-400" />
            <span>Netačno (Falsch)</span>
          </button>
        </div>

        {!submitted ? (
          <button
            onClick={handleSubmit}
            disabled={selectedChoice === null}
            className="w-full py-3 bg-indigo-600 hover:bg-indigo-500 disabled:opacity-40 text-white rounded-xl font-bold text-sm transition"
          >
            Potvrdi Odgovor
          </button>
        ) : (
          <div className="space-y-4 animate-fadeIn">
            <div className={`p-4 rounded-xl border text-sm ${
              selectedChoice === current.isCorrect
                ? 'bg-emerald-950/30 border-emerald-500/40 text-emerald-200'
                : 'bg-rose-950/30 border-rose-500/40 text-rose-200'
            }`}>
              <p className="font-bold mb-1 flex items-center gap-2">
                {selectedChoice === current.isCorrect ? (
                  <CheckCircle2 className="w-4 h-4 text-emerald-400" />
                ) : (
                  <XCircle className="w-4 h-4 text-rose-400" />
                )}
                {selectedChoice === current.isCorrect ? 'Odlično! Tačan odgovor.' : 'Pogrešno! Pogledaj objašnjenje ispod.'}
              </p>
              <p className="text-xs text-slate-300 mt-2 leading-relaxed">{current.explanation}</p>
              {!current.isCorrect && (
                <div className="mt-3 pt-2 border-t border-slate-800">
                  <span className="text-[10px] text-slate-400 uppercase font-bold block">Tačna rečenica:</span>
                  <p className="text-emerald-300 font-semibold text-xs italic">"{current.correctSentence}"</p>
                </div>
              )}
            </div>

            <button
              onClick={handleNext}
              className="w-full py-3 bg-slate-800 hover:bg-slate-700 text-white rounded-xl font-bold text-sm transition flex items-center justify-center gap-2"
            >
              <RotateCcw className="w-4 h-4" /> Sljedeća Rečenica
            </button>
          </div>
        )}
      </div>
    </div>
  );
}

